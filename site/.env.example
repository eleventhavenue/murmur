# Murmur site environment.
# Copy to .env.local and fill in. Every value is optional: with none of them the
# site still builds and runs, showing demo data where live data would go.

# ---------------------------------------------------------------- Supabase
# Project settings → API. The anon key is public and safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ Stripe
# Developers → API keys. Use sk_test_… until you are ready to charge.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or Developers → Webhooks → your endpoint → signing secret.
STRIPE_WEBHOOK_SECRET=

# Price IDs (price_…, not product IDs) for the two paid tiers.
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PLUS_PRICE_ID=

# ------------------------------------------------------------- Cloud voices
# Powers /api/tts, the Pro-tier voice proxy. With this set, subscribers get
# premium voices using their license key instead of their own Cartesia account.
CARTESIA_API_KEY=

# -------------------------------------------------------------------- Site
# Absolute origin used for Stripe redirects. Vercel sets this automatically in
# production; set it locally if you are testing checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Override only if you fork the project.
NEXT_PUBLIC_GITHUB_REPO=eleventhavenue/murmur
